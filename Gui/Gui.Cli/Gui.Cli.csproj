<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- A console-subsystem companion so stdout reaches the calling shell (a WinExe/GUI
         subsystem binary cannot write to a parent console). Ships next to Gui.exe. -->
    <OutputType>Exe</OutputType>
    <!-- The Windows TFM, not plain net8.0: Term/Keybinds.cs reads VirtualKey, which comes
         from the Windows SDK projection. No Windows App SDK or WinUI package is involved. -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <AssemblyName>gui-cli</AssemblyName>
    <RootNamespace>Gui.Cli</RootNamespace>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- Same rule as the app: a build without -p:Version reports itself as a development
         build in `gui +version`, not as the SDK's 1.0.0 default. The commit hash stays out
         of the product version, as in the app. -->
    <InformationalVersion Condition="'$(Version)' == ''">dev</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>

    <!-- Config.cs uses the Windows registry under Resolve(), which the CLI never calls.
         Under a plain net8.0 TFM the platform analyzer still flags those call sites. -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>

    <!-- Follow the solution's Platform so the RID (and therefore the output folder) matches
         the terminal's win-x64 / win-x86 / win-arm64 layout. -->
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifier Condition="'$(Platform)' == 'x64'">win-x64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(Platform)' == 'x86'">win-x86</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>
  </PropertyGroup>

  <!-- Compile the shipped config sources themselves, not copies. These are plain BCL C#,
       so the CLI needs no WinUI, Win2D or NuGet packages and stays independent of the app's
       runtime bootstrap. LoadRaw() keeps parsing free of any libghostty-vt call. -->
  <ItemGroup>
    <!-- The installer ships gui-cli trimmed, and this assembly is rooted whole: it is 177 KB,
         so trimming it saves nothing worth the risk of a reflection or interop member
         disappearing. IPC's JSON does not need the root - IpcProtocol carries its own
         generated JsonSerializerContext - so what the root now protects is the rest of what
         the CLI links: Config, Keybinds and the GhosttyNative P/Invoke surface. -->
    <TrimmerRootAssembly Include="gui-cli" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../Gui/Strings.cs" Link="Strings.cs" />
    <Compile Include="../Gui/Diag.cs" Link="Diag.cs" />
    <Compile Include="../Gui/Term/Config.cs" Link="Config.cs" />
    <Compile Include="../Gui/Term/ConfigSchema.cs" Link="ConfigSchema.cs" />
    <Compile Include="../Gui/Term/ColorReport.cs" Link="ColorReport.cs" />
    <Compile Include="../Gui/Term/FontCatalog.cs" Link="FontCatalog.cs" />
    <Compile Include="../Gui/Term/GhosttyNative.cs" Link="GhosttyNative.cs" />
    <Compile Include="../Gui/Term/Keybinds.cs" Link="Keybinds.cs" />
    <Compile Include="../Gui/Term/KeyRemap.cs" Link="KeyRemap.cs" />
    <Compile Include="../Gui/Term/QuickTerminalGeometry.cs" Link="QuickTerminalGeometry.cs" />
    <Compile Include="../Gui/Term/IpcProtocol.cs" Link="IpcProtocol.cs" />
    <Compile Include="../Gui/Term/TerminalTheme.cs" Link="TerminalTheme.cs" />
  </ItemGroup>
</Project>
