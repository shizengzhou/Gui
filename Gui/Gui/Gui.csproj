<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Gui</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- The app icon (installer, taskbar and alt-tab come from this embedded resource).
         Regenerate it with: python installer/make-icon.py Gui/Gui/Assets -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- Without this the informational version becomes "1.2.3+<commit>", which ends up in the
         exe's Product version in Explorer. The build number belongs in the build log, not in
         a property sheet. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <!-- A build nobody stamped with -p:Version is a development build: About, `gui +version`
         and Explorer's Product version say "dev" instead of the SDK's 1.0.0 default. Release
         builds get their version from build-installer.ps1 and the release workflow. -->
    <InformationalVersion Condition="'$(Version)' == ''">dev</InformationalVersion>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>

    <!-- Unpackaged and self-contained, exactly like the native project the UI was ported
         from: no MSIX, no framework-package dependency, the Windows App SDK ships next to
         the exe. Without SelfContained the DeploymentManager initializer tries to install
         the runtime package and fails with 0x80070005 before App's constructor runs. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <EnableMsixTooling>false</EnableMsixTooling>

    <!-- The Windows App SDK runtime assets are per-architecture, so the RID follows Platform. -->
    <RuntimeIdentifier Condition="'$(Platform)' == 'x64'">win-x64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(Platform)' == 'x86'">win-x86</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup>
    <!-- Same versions as the native project's packages.config. -->
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2957" />
    <!-- The Windows App SDK as component packages instead of the umbrella: the umbrella also
         pulls Microsoft.WindowsAppSDK.AI and .ML, which drag onnxruntime.dll (20.7 MB) and
         DirectML.dll (17.8 MB) into the payload although nothing here calls a Windows AI API.
         Widgets is left out for the same reason (unused). The versions are the ones the
         umbrella 1.8.260921001 pinned, so the runtime payload is the same build; the bracket
         form keeps a later restore from floating them. -->
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="[1.8.260803003]" />
    <PackageReference Include="Microsoft.WindowsAppSDK.DWrite" Version="[1.8.25122902]" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Runtime" Version="[1.8.260921001]" />
    <PackageReference Include="Microsoft.Graphics.Win2D" Version="1.4.0" />
    <!-- "custom-shader": compile Shadertoy-style GLSL at runtime. Shaderc turns the source
         into SPIR-V, SPIRV-Cross emits HLSL, and D3DCompiler builds the pixel shader blob
         Win2D's PixelShaderEffect consumes. -->
    <PackageReference Include="Silk.NET.Shaderc" Version="2.23.0" />
    <PackageReference Include="Silk.NET.SPIRV.Cross" Version="2.23.0" />
    <PackageReference Include="Vortice.D3DCompiler" Version="3.8.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- Native libghostty-vt build output (see native/build-ghostty-vt.sh). -->
    <Content Include="native\$(Platform)\ghostty-vt.dll" Link="ghostty-vt.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Windows Terminal's ConPTY (MIT, see ConPTY-LICENSE.txt). Gui prefers it over the
         system implementation when both files sit next to Gui.exe; see ConPty's static
         constructor. Copying the whole folder keeps the licence beside the binaries. -->
    <Content Include="native\$(Platform)\conpty\*" Link="%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Bundled fonts and Ghostty themes, loaded from the exe directory. -->
    <Content Include="Assets\\**\\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <PropertyGroup>
    <!-- The CLI is a shipped artifact, not an assembly the app loads (ReferenceOutputAssembly
         = false below). The SDK otherwise rejects a self-contained app referencing a
         framework-dependent exe with NETSDK1150 during publish; this guard does not apply. -->
    <ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>
  </PropertyGroup>

  <ItemGroup>
    <!-- Build the companion CLI with the app and ship it next to Gui.exe. ReferenceOutputAssembly
         keeps it out of the WinUI app's references; the CLI links the config sources itself. -->
    <ProjectReference Include="..\Gui.Cli\Gui.Cli.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

    <!-- Publish Properties -->
  <PropertyGroup>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Debug'">False</PublishReadyToRun>
    <PublishReadyToRun Condition="'$(Configuration)' != 'Debug'">True</PublishReadyToRun>

    <!-- Never trim the app: WinUI's XAML support is not trim-safe. the CLI is trimmed in its
         own publish below, where the trimmer sees the IL it actually needs. -->
    <PublishTrimmed>False</PublishTrimmed>
  </PropertyGroup>

  <!-- A self-contained Windows App SDK is extracted from the framework MSIX, and that MSIX also
       carries the AI/ML native libraries: onnxruntime.dll (20.7 MB) and DirectML.dll (17.8 MB).
       Nothing here calls a Windows AI API, so they are dropped from the payload instead of
       shipping 38 MB that is never loaded. The SDK exposes the file list only as `None` items
       (see Microsoft.WindowsAppSDK.SelfContained.targets), so they are filtered here, right
       after the target that adds them and before they are copied to the output. -->
  <Target Name="DropWindowsAppSdkAiPayload" AfterTargets="AddMicrosoftWindowsAppSDKPayloadFilesFromMsix">
    <ItemGroup>
      <_WindowsAppSdkAiFile Include="@(None)"
          Condition="'%(Filename)' == 'onnxruntime' or '%(Filename)' == 'onnxruntime_providers_shared' or '%(Filename)' == 'DirectML'" />
      <None Remove="@(_WindowsAppSdkAiFile)" />
    </ItemGroup>
  </Target>

  <!-- ReferenceOutputAssembly=false keeps the CLI's assembly out of the app's compile
       references, but MSBuild still copies its apphost, .deps.json and .runtimeconfig.json.
       The CLI deploys as "gui" into a bin\ subfolder: it no longer shares a folder with
       Gui.exe, so the name no longer collides on a case-insensitive filesystem. -->
  <Target Name="CollectCliOutput" DependsOnTargets="ResolveProjectReferences">
    <!-- GetTargetPath returns an absolute path to gui-cli.dll; its directory is the CLI's
         output folder, so this stays correct even when the output path is overridden. -->
    <MSBuild Projects="..\Gui.Cli\Gui.Cli.csproj" Targets="GetTargetPath">
      <Output TaskParameter="TargetOutputs" ItemName="_CliTarget" />
    </MSBuild>
    <PropertyGroup>
      <_CliDir>@(_CliTarget->'%(RootDir)%(Directory)')</_CliDir>
    </PropertyGroup>
    <ItemGroup>
      <!-- Only the CLI's own files: never copy the .NET runtime, which would add an
           app-local hostfxr.dll and stop the framework-dependent Gui.exe from starting. -->
      <_CliOutputFiles Include="$(_CliDir)gui-cli.*" Exclude="$(_CliDir)gui-cli.pdb" />
      <!-- Split so the apphost can land as bin\gui.exe while the assembly and its
           .deps.json / .runtimeconfig.json keep their own names. -->
      <_CliExe Include="@(_CliOutputFiles)" Condition="'%(Extension)' == '.exe'" />
      <_CliSide Include="@(_CliOutputFiles)" Condition="'%(Extension)' != '.exe'" />
    </ItemGroup>
  </Target>

  <Target Name="CopyCliOutputToBuild" AfterTargets="Build" DependsOnTargets="CollectCliOutput">
    <Copy SourceFiles="@(_CliExe)" DestinationFiles="@(_CliExe->'$(OutDir)bin\gui%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_CliSide)" DestinationFiles="@(_CliSide->'$(OutDir)bin\%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <!-- The ProjectReference also drops the CLI's own apphost and its .deps/.runtimeconfig
         into the output root. bin\gui.exe is the only place the CLI may live: it is the name
         the PATH entry and the panes look for, and a second gui-cli.exe next to Gui.exe is
         just something to run by mistake. -->
    <ItemGroup>
      <_StrayBuildCliFile Include="$(OutDir)gui-cli.*" />
    </ItemGroup>
    <Delete Files="@(_StrayBuildCliFile)" />
  </Target>

  <!-- A framework-dependent publish leaves the CLI in bin\ too, where its apphost finds the
       shared runtime. A self-contained publish needs the single-file build below. -->
  <Target Name="CopyCliOutputToPublish" AfterTargets="Publish" DependsOnTargets="CollectCliOutput" Condition="'$(SelfContained)' != 'true'">
    <Copy SourceFiles="@(_CliExe)" DestinationFiles="@(_CliExe->'$(PublishDir)bin\gui%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_CliSide)" DestinationFiles="@(_CliSide->'$(PublishDir)bin\%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <!-- The ProjectReference also drops the CLI's apphost, .deps.json and .runtimeconfig.json
         into the payload root. Only bin may carry the CLI, or a PATH entry on the root would
         expose the WinUI DLLs again. -->
    <ItemGroup>
      <_StrayFddCliFile Include="$(PublishDir)gui-cli.*" />
    </ItemGroup>
    <Delete Files="@(_StrayFddCliFile)" />
  </Target>

  <!-- A self-contained publish has an app-local hostfxr and no installed framework, so a
       framework-dependent apphost cannot start there. The CLI therefore goes into the
       payload's "bin" subfolder, self-contained and trimmed to a single 12 MB file.
       Two reasons it is not published into the payload root with the app: the root is full
       of WinUI DLLs (DWriteCore, hostfxr, Microsoft.ui.xaml), and a PATH entry pointing
       there makes unrelated programs load our private copies — the WeChat IME holds
       DWriteCore.dll from it, which turns every upgrade into a "files in use" prompt. bin\
       holds gui.exe (the CLI) and nothing else, so a PATH entry there is harmless.
       No Restore call: the RID's runtime pack is already in the NuGet cache, and restoring
       here would rewrite the CLI's obj state and break later framework-dependent builds. -->
  <!-- Unpackaged WinUI 3 keeps its compiled XAML in Gui.pri and the .xbf files, but the
       Publish target does not copy them, so a published Gui.exe dies at startup with
       XamlParseException (0x802B000A) in MainWindow's LoadComponent. Copy them over from
       the build output; PublishDir stays freely configurable via a publish profile. -->
  <Target Name="CopyXamlResourcesToPublish" AfterTargets="Publish">
    <ItemGroup>
      <_XamlResource Include="$(OutDir)*.xbf;$(OutDir)Gui.pri" />
    </ItemGroup>
    <Copy SourceFiles="@(_XamlResource)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="PublishCliToBin" AfterTargets="CopyCliOutputToPublish" Condition="'$(SelfContained)' == 'true'">
    <PropertyGroup>
      <_CliPublishDir>$([MSBuild]::EnsureTrailingSlash($([System.IO.Path]::GetFullPath($([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', '$(PublishDir)', 'bin'))))))</_CliPublishDir>
    </PropertyGroup>
    <!-- A separate dotnet publish rather than the MSBuild task: run inside this build, the CLI
         inherits the app's publish properties and silently publishes untrimmed (93 MB instead
         of 13 MB). -->
    <Exec Command="dotnet publish &quot;$(MSBuildProjectDirectory)\..\Gui.Cli\Gui.Cli.csproj&quot; -c $(Configuration) -p:Platform=$(Platform) -p:Version=$(Version) --self-contained -p:PublishDir=$(_CliPublishDir) -p:PublishSingleFile=true -p:PublishTrimmed=true -p:PublishReadyToRun=false -p:DebugType=None -p:DebugSymbols=false --nologo" />
    <!-- The assembly keeps its project name; only the deployed file is "gui". -->
    <Delete Files="$(_CliPublishDir)gui.exe" />
    <Move SourceFiles="$(_CliPublishDir)gui-cli.exe" DestinationFiles="$(_CliPublishDir)gui.exe" />
    <!-- The ProjectReference itself still drops the CLI's apphost, .deps.json and
         .runtimeconfig.json into the payload root; only bin may carry the CLI, or a PATH
         entry on the root would expose the WinUI DLLs again. -->
    <ItemGroup>
      <_StrayCliFile Include="$(PublishDir)gui-cli.*" />
    </ItemGroup>
    <Delete Files="@(_StrayCliFile)" />
  </Target>
</Project>
