<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Gui</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>

    <!-- Unpackaged and self-contained, exactly like the native project the UI was ported
         from: no MSIX, no framework-package dependency, the Windows App SDK ships next to
         the exe. Without SelfContained the DeploymentManager initializer tries to install
         the runtime package and fails with 0x80070005 before App's constructor runs. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <EnableMsixTooling>false</EnableMsixTooling>

    <!-- The Windows App SDK runtime assets are per-architecture, so the RID follows Platform. -->
    <RuntimeIdentifier Condition="'$(Platform)' == 'x64'">win-x64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(Platform)' == 'x86'">win-x86</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup>
    <!-- Same versions as the native project's packages.config. -->
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2957" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
    <PackageReference Include="Microsoft.Graphics.Win2D" Version="1.4.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Native libghostty-vt build output (see native/build-ghostty-vt.sh). -->
    <Content Include="native\$(Platform)\ghostty-vt.dll" Link="ghostty-vt.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Bundled fonts and Ghostty themes, loaded from the exe directory. -->
    <Content Include="Assets\\**\\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <PropertyGroup>
    <!-- The CLI is a shipped artifact, not an assembly the app loads (ReferenceOutputAssembly
         = false below). The SDK otherwise rejects a self-contained app referencing a
         framework-dependent exe with NETSDK1150 during publish; this guard does not apply. -->
    <ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>
  </PropertyGroup>

  <ItemGroup>
    <!-- Build the companion CLI with the app and ship it next to Gui.exe. ReferenceOutputAssembly
         keeps it out of the WinUI app's references; the CLI links the config sources itself. -->
    <ProjectReference Include="..\Gui.Cli\Gui.Cli.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

    <!-- Publish Properties -->
  <PropertyGroup>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Debug'">False</PublishReadyToRun>
    <PublishReadyToRun Condition="'$(Configuration)' != 'Debug'">True</PublishReadyToRun>
    <PublishTrimmed Condition="'$(Configuration)' == 'Debug'">False</PublishTrimmed>
    <PublishTrimmed Condition="'$(Configuration)' != 'Debug'">True</PublishTrimmed>
  </PropertyGroup>

  <!-- ReferenceOutputAssembly=false keeps gui-cli.dll out of the app's compile references,
       but MSBuild then copies only the CLI's apphost, .deps.json and .runtimeconfig.json.
       Copy all gui-cli.* files so the exe has its managed assembly next to Gui.exe. -->
  <Target Name="CollectCliOutput" DependsOnTargets="ResolveProjectReferences">
    <!-- GetTargetPath returns an absolute path to gui-cli.dll; its directory is the CLI's
         output folder, so this stays correct even when the output path is overridden. -->
    <MSBuild Projects="..\Gui.Cli\Gui.Cli.csproj" Targets="GetTargetPath">
      <Output TaskParameter="TargetOutputs" ItemName="_CliTarget" />
    </MSBuild>
    <PropertyGroup>
      <_CliDir>@(_CliTarget->'%(RootDir)%(Directory)')</_CliDir>
    </PropertyGroup>
    <ItemGroup>
      <!-- Only the CLI's own files: never copy the .NET runtime, which would add an
           app-local hostfxr.dll and stop the framework-dependent Gui.exe from starting. -->
      <_CliOutputFiles Include="$(_CliDir)gui-cli.*" Exclude="$(_CliDir)gui-cli.pdb" />
    </ItemGroup>
  </Target>

  <Target Name="CopyCliOutputToBuild" AfterTargets="Build" DependsOnTargets="CollectCliOutput">
    <Copy SourceFiles="@(_CliOutputFiles)"
          DestinationFiles="@(_CliOutputFiles->'$(OutDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyCliOutputToPublish" AfterTargets="Publish" DependsOnTargets="CollectCliOutput">
    <Copy SourceFiles="@(_CliOutputFiles)"
          DestinationFiles="@(_CliOutputFiles->'$(PublishDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <!-- A self-contained publish has an app-local hostfxr and no installed framework, so a
       framework-dependent gui-cli.exe cannot start there. Publish the CLI self-contained
       into the same folder; it brings the same .NET runtime the app already ships. No
       Restore call: the RID's runtime pack is already in the NuGet cache, and restoring
       here would rewrite the CLI's obj state and break later framework-dependent builds. -->
  <Target Name="PublishCliSelfContained" AfterTargets="CopyCliOutputToPublish"
          Condition="'$(SelfContained)' == 'true'">
    <PropertyGroup>
      <_CliPublishDir>$([MSBuild]::EnsureTrailingSlash($([System.IO.Path]::GetFullPath($([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', '$(PublishDir)'))))))</_CliPublishDir>
    </PropertyGroup>
    <MSBuild Projects="..\Gui.Cli\Gui.Cli.csproj" Targets="Publish"
             RemoveProperties="PublishProfile"
             Properties="Configuration=$(Configuration);Platform=$(Platform);SelfContained=true;PublishDir=$(_CliPublishDir);PublishReadyToRun=false;PublishTrimmed=false;PublishSingleFile=false" />
  </Target>
</Project>
